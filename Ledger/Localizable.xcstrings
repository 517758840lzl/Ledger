    "settings.privacy" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私政策"
          }
        }
      }
    },
    "settings.privacy_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy\n\nLedger stores your bookkeeping data only on this device. There is no account sign-in, no cloud sync by default, and we do not sell personal information.\n\nNotification permission is used only for optional reminders you enable. Export/share uses the system share sheet; recipients depend on your choice.\n\nYou can clear local data anytime in Settings. Continued use means you understand on-device processing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私政策\n\nLedger 将记账数据仅保存在你的设备本地，不创建账号，不主动上传云端，也不出售个人信息。\n\n我们可能申请通知权限，仅用于你开启的记账提醒。导出/分享文件时，由系统分享面板处理，接收方取决于你的选择。\n\n你可以随时在设置中清空本机数据。继续使用即表示你理解本应用的本地处理方式。"
          }
        }
      }
    },
    "settings.privacy_collect_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts, categories, accounts, dates, and notes you enter. We do not read contacts, SMS, or payment-app feeds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你主动记下的金额、分类、账户、日期和备注。我们不采集通讯录、短信或支付 App 流水。"
          }
        }
      }
    },
    "settings.privacy_collect_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

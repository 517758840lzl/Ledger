    "settings.privacy_intro_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledger keeps books, accounts, categories, budgets, and unlock codes only on this device. No account signup, no private cloud upload."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledger 是纯本地记账工具。账目、账户、分类、预算、解锁密码仅保存在本机，不创建账号，也不上传到自建云。"
          }
        }
      }
    },
    "settings.privacy_intro_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私政策"
          }
        }
      }
    },
    "settings.privacy_rights_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export, import, or clear local data anytime. Uninstalling removes the on-device ledger (subject to OS behavior)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可随时导出、导入或清空本机数据。卸载应用即删除本地账本（以系统行为为准）。"
          }
        }
      }
    },
    "settings.privacy_rights_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your rights"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的权利"
          }
        }
      }
    },
    "settings.privacy_third_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No analytics SDK or login service. If you use system biometrics, the OS handles recognition; Ledger only gets success/failure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不接入分析 SDK 或登录服务。若使用系统生物识别，识别过程由操作系统完成，Ledger 只收到成功/失败。"
          }
        }
      }
    },
    "settings.privacy_third_title" : {
